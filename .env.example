# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth.js ---
# generate with: openssl rand -base64 33
AUTH_SECRET=
# public origin Auth.js issues callback URLs against, e.g. https://board.example.com
# bare origin only — no /api/auth suffix, Auth.js appends its basePath itself. Adding it
# yourself triggers an "env-url-basepath-redundant" warning and breaks page rendering.
AUTH_URL=http://localhost:3000

# --- App ---
# origin(s) the browser app is served from (CORS allow-list, not a wildcard) — comma-separated
# for multiple, e.g. https://board.example.com,https://staging.board.example.com
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=production

# first login on this email is auto-approved + made super_admin, bootstrapping admin
# access without a manual DB edit
SUPER_ADMIN_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://tlboard:change_me@localhost:5432/tlboard

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=change_me
